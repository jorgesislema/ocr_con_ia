# ══════════════════════════════════════════════════════════════════
# OCR Con IA — SaaS · plantilla de entorno de desarrollo
# Copia este archivo a ".env" y rellena las claves necesarias.
# En producción NO usar .env: definir SECRET_BACKEND (infisical|vault).
# ══════════════════════════════════════════════════════════════════

# ── Entorno ────────────────────────────────────────────────────────
OCR_ENVIRONMENT=development

# ── Proveedor IA por defecto (regla arquitectónica #1) ────────────
# auto = el sistema elige según la dificultad del documento
OCR_DEFAULT_AI_PROVIDER=auto
OCR_GEMINI_MODEL=gemini-2.0-flash
OCR_MISTRAL_OCR_MODEL=mistral-ocr-latest
OCR_MISTRAL_LLM_MODEL=mistral-large-latest

# ── API Keys (leídas SIEMPRE vía app.core.config.get_secret) ──────
GEMINI_API_KEY=
MISTRAL_API_KEY=

# ── Base de datos (TAREA 3.1) ──────────────────────────────────────
# Dev: vacío → SQLite local (storage/saas.db).
# Prod: DATABASE_URL de Supabase/Render, ej:
#   DATABASE_URL=postgres://usuario:pass@host:5432/ocr
DATABASE_URL=

# ── Cola asíncrona (TAREA 3.2) ─────────────────────────────────────
# Sin REDIS_URL → BackgroundTasks de FastAPI (despliegue costo cero,
# ideal para <100 documentos/día). Con REDIS_URL → Celery + Redis.
REDIS_URL=

# ── Autenticación JWT (TAREA 1) ────────────────────────────────────
# OBLIGATORIO cambiar en producción (genera uno: openssl rand -hex 32)
JWT_SECRET=dev-only-secret-cambiar-en-produccion
JWT_EXPIRE_MINUTES=1440
# Clave de operador para crear cuentas (modelo sin pasarela: el cliente
# paga por transferencia y habilitas su cuenta con esta clave).
ADMIN_KEY=

# ── CORS (TAREA 3.3): dominio del frontend (Vercel/Netlify) ───────
# CORS_ORIGINS=https://tu-app.vercel.app
# CORS_ORIGIN_REGEX=https://.*\.(vercel\.app|netlify\.app)

# ── Backend de secretos en PRODUCCIÓN (opcional en dev) ───────────
# SECRET_BACKEND=infisical
# INFISICAL_HOST=https://app.infisical.com
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# SECRET_BACKEND=vault
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=
# VAULT_MOUNT=secret
